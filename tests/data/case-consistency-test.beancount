option "title" "Case Consistency Test Ledger"
option "operating_currency" "USD"
option "account_previous_balances" "Equity:Opening-Balances"

; Commodities with aliases and case variants
2024-01-01 commodity USD
  name: "US Dollar"
  precision: 2

2024-01-01 commodity BTC
  name: "Bitcoin"
  alias: "BITCOIN,btc"
  precision: 8

2024-01-01 commodity ETH
  name: "Ethereum"
  alias: "ETHEREUM,eth"
  precision: 6

2024-01-01 commodity AAPL
  name: "Apple Inc."
  alias: "apple,aapl"
  precision: 2

; Accounts
2024-01-01 open Assets:Cash USD
2024-01-01 open Assets:Investment:BTC BTC,USD
2024-01-01 open Assets:Investment:ETH ETH,USD
2024-01-01 open Assets:Investment:Stocks AAPL,USD
2024-01-01 open Equity:Opening-Balances
2024-01-01 open Income:Capital-Gains
2024-01-01 open Expenses:Fees

; Prices with case variations
2024-01-01 price BTC 42000.00 USD
2024-01-01 price BITCOIN 42000.00 USD
2024-01-15 price ETH 2500.00 USD
2024-01-15 price ethereum 2500.00 USD
2024-02-01 price AAPL 185.50 USD
2024-02-01 price apple 185.50 USD

; Opening balances using different case variants
2024-01-01 * "Opening balance - BTC"
  Assets:Investment:BTC 0.5 BTC {40000 USD}
  Equity:Opening-Balances -20000 USD

2024-01-02 * "Opening balance - BTC using alias"
  Assets:Investment:BTC 0.3 BITCOIN {40500 USD}
  Equity:Opening-Balances -12150 USD

2024-01-03 * "Opening balance - BTC lowercase"
  Assets:Investment:BTC 0.2 btc {41000 USD}
  Equity:Opening-Balances -8200 USD

2024-01-10 * "Opening balance - ETH"
  Assets:Investment:ETH 2 ETH {2200 USD}
  Equity:Opening-Balances -4400 USD

2024-01-12 * "Opening balance - ETH using alias"
  Assets:Investment:ETH 1 ethereum {2300 USD}
  Equity:Opening-Balances -2300 USD

2024-02-05 * "Purchase AAPL stock"
  Assets:Investment:Stocks 10 AAPL {180 USD}
  Assets:Cash -1800 USD

2024-02-06 * "Purchase AAPL using alias"
  Assets:Investment:Stocks 5 aapl {182 USD}
  Assets:Cash -910 USD

2024-02-10 * "Purchase AAPL using name alias"
  Assets:Investment:Stocks 15 apple {184 USD}
  Assets:Cash -2760 USD

2024-03-01 * "Sell some BTC"
  Assets:Investment:BTC -0.1 BTC @ 45000 USD
  Assets:Cash 4500 USD
  Income:Capital-Gains -500 USD

2024-03-15 * "Sell some ETH"
  Assets:Investment:ETH -0.5 ETH @ 2600 USD
  Assets:Cash 1300 USD
  Income:Capital-Gains -200 USD
